{
 "prose": {
  "label": "PROMPT",
  "group": "playing",
  "description": "Your character speaks or acts; the model continues the scene — sent verbatim"
 },
 "groups": {
  "playing": "Playing",
  "inline": "Inside a prompt",
  "stories": "Stories",
  "lore": "Lore",
  "inspect": "Inspect",
  "transfer": "Import/export",
  "settings": "Models and settings",
  "meta": "Meta"
 },
 "answers": [
  "/fork",
  "/merge",
  "/model",
  "/new",
  "/set autocorrect",
  "/set max_context",
  "/set notification",
  "/set parameter",
  "/set think",
  "/set verbose",
  "/system",
  "/title",
  "/undo"
 ],
 "rows": [
  {
   "token": "/me",
   "args": "NAME: PROMPT",
   "description": "Send PROMPT, hinting the model that you write as NAME",
   "group": "playing",
   "kind": "syntax"
  },
  {
   "token": "/you",
   "args": "NAME[: HINT]",
   "description": "Tell the model to play NAME; optional HINT rides the turn",
   "group": "playing",
   "kind": "syntax"
  },
  {
   "token": "/ooc",
   "args": "PROMPT",
   "description": "Talk to the model out of character",
   "group": "playing",
   "kind": "syntax"
  },
  {
   "token": "/undo",
   "args": "",
   "description": "Discard the last turn",
   "group": "playing",
   "kind": "interactive"
  },
  {
   "token": "/regen",
   "args": "",
   "description": "Re-run the last prompt (mid-stream: cancel + regen)",
   "group": "playing",
   "kind": "interactive"
  },
  {
   "token": "/last",
   "args": "[N]",
   "description": "Show the last N turns (default 5) — a clean view after undos, regens, etc.",
   "group": "playing",
   "kind": "interactive"
  },
  {
   "token": "/clear",
   "args": "",
   "description": "Clear the screen",
   "group": "playing",
   "kind": "interactive"
  },
  {
   "token": "… /ooc",
   "args": "TEXT",
   "description": "An aside out of character",
   "group": "inline",
   "kind": "syntax"
  },
  {
   "token": "… /cue",
   "args": "TEXT",
   "description": "Steer just the next reply — not kept in context afterwards",
   "group": "inline",
   "kind": "syntax"
  },
  {
   "token": "/stories",
   "args": "",
   "description": "Browse stories, resume an old one",
   "group": "stories",
   "kind": "interactive"
  },
  {
   "token": "/fork",
   "args": "[TITLE]",
   "description": "Continue in a copy of this story; the original stays",
   "group": "stories",
   "kind": "operation"
  },
  {
   "token": "/system",
   "args": "<text | FILE>",
   "description": "Set the system prompt for this story — either directly or from a file",
   "group": "stories",
   "kind": "interactive"
  },
  {
   "token": "/title",
   "args": "NEW",
   "description": "Set the story title",
   "group": "stories",
   "kind": "operation"
  },
  {
   "token": "/new",
   "args": "[TITLE]",
   "description": "Clear context and start a new story",
   "group": "stories",
   "kind": "operation"
  },
  {
   "token": "/lore",
   "args": "",
   "description": "Browse and edit the memory: scenes, cast, journals",
   "group": "lore",
   "kind": "interactive"
  },
  {
   "token": "/cast",
   "args": "",
   "description": "The same browser, opened directly on the cast",
   "group": "lore",
   "kind": "interactive"
  },
  {
   "token": "/extract",
   "args": "",
   "description": "Extract lore from the recent messages now; triggered automatically after 5 minutes of inactivity",
   "group": "lore",
   "kind": "interactive"
  },
  {
   "token": "/merge",
   "args": "A into B",
   "description": "Fold a duplicate character into the real one",
   "group": "lore",
   "kind": "operation"
  },
  {
   "token": "/context",
   "args": "",
   "description": "Preview the next request (assembled prompt + budgets)",
   "group": "inspect",
   "kind": "interactive"
  },
  {
   "token": "/balance",
   "args": "",
   "description": "Account balance of cloud providers",
   "group": "inspect",
   "kind": "operation"
  },
  {
   "token": "/usage",
   "args": "[all]",
   "description": "Tokens spent on this story (or everything)",
   "group": "inspect",
   "kind": "operation"
  },
  {
   "token": "/info",
   "args": "",
   "description": "Show details about the current model + session",
   "group": "inspect",
   "kind": "operation"
  },
  {
   "token": "/card",
   "args": "FILE [NAME]",
   "description": "Import a character card (PNG or JSON) into this story — NAME renames them",
   "group": "transfer",
   "kind": "interactive"
  },
  {
   "token": "/import",
   "args": "FILE",
   "description": "Import a story: an otaku export, SillyTavern chat (.jsonl), or plain text",
   "group": "transfer",
   "kind": "interactive"
  },
  {
   "token": "/export",
   "args": "[FILE]",
   "description": "Export the whole story to Markdown (memory + messages)",
   "group": "transfer",
   "kind": "interactive"
  },
  {
   "token": "/model",
   "args": "[PROVIDER/MODEL]",
   "description": "Switch model",
   "group": "settings",
   "kind": "interactive"
  },
  {
   "token": "/set think",
   "args": "<level>",
   "description": "Thinking effort for the model: on|off|none|low|medium|high|max|default",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/set parameter",
   "args": "<name> <val>",
   "description": "Set an inference parameter for the model; no <val> shows it, <val> = reset returns the default",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/set verbose",
   "args": "on|off",
   "description": "Show the stats line after each reply",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/set autocorrect",
   "args": "on|off",
   "description": "Settle a character name you type in /you and /me commands to the cast's own spelling",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/set notification",
   "args": "on|off",
   "description": "Play a sound when a reply lands (the sound is configs/config.toml's notification_sound)",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/set max_context",
   "args": "<tokens>",
   "description": "Cap the prompt at this many tokens; 0 = the model's whole window",
   "group": "settings",
   "kind": "operation"
  },
  {
   "token": "/help",
   "args": "",
   "description": "Show this help",
   "group": "meta",
   "kind": "interactive"
  },
  {
   "token": "/bye",
   "args": "",
   "description": "Exit",
   "group": "meta",
   "kind": "interactive"
  }
 ]
}
